#!/usr/bin/env python3
"""Magic — toggle between Home and Away power states.

Home:  normal ACPI sleep, cosmic-idle screen lock (per your Preferences
       timeouts), Wake-on-LAN off.
Away:  sleep/hibernate masked (stays in S0 for Tailscale + Sunshine),
       cosmic-idle timeouts disabled, Wake-on-LAN armed on eno1.

cosmic-idle is spawned directly by cosmic-session, not through its
systemd unit, so idle behavior is controlled by writing COSMIC's own
config at ~/.config/cosmic/com.system76.CosmicIdle/v1/* — the exact
same files cosmic-settings' Power panel edits, so there's no separate
"Magic state" that can drift from what System Settings shows.

While this window is open it polls local state every few seconds and,
if Away Mode is active and the eno1 cable is pulled, reverts to Home
Mode automatically (WoL needs the cable, so there's no reason to keep
sleep disabled without it). Nothing runs when the window is closed.
"""
import base64
import http.client
import json
import os
import re
import ssl
import subprocess
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk  # noqa: E402

try:
    gi.require_version("Secret", "1")
    from gi.repository import Secret  # noqa: E402

    HAVE_SECRET = True
except (ValueError, ImportError):
    HAVE_SECRET = False

APP_ID = "com.jakobsax.Magic"
# Must match magic-helper's IFACE/CONN exactly — see the comment there.
IFACE = "eno1"
CONN = "Wired connection 1"
HELPER = "/usr/local/libexec/magic-helper"
POLL_SECONDS = 4

STATE_DIR = os.path.expanduser("~/.config/magic")
STATE_FILE = os.path.join(STATE_DIR, "state.json")
DEFAULT_STATE = {
    "home_screen_off_min": 10,
    "home_suspend_min": 15,
    "last_device_name": "",
    "sunshine_host": "localhost",
    "sunshine_port": 47990,
}

IDLE_CONFIG_DIR = os.path.expanduser("~/.config/cosmic/com.system76.CosmicIdle/v1")

if HAVE_SECRET:
    SUNSHINE_SCHEMA = Secret.Schema.new(
        "com.jakobsax.Magic.Sunshine",
        Secret.SchemaFlags.NONE,
        {"service": Secret.SchemaAttributeType.STRING},
    )


def run(cmd, timeout=5):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
    except (subprocess.TimeoutExpired, FileNotFoundError) as e:
        return subprocess.CompletedProcess(cmd, 1, "", str(e))


def is_away_mode() -> bool:
    return run(["systemctl", "is-enabled", "sleep.target"]).stdout.strip() == "masked"


def eno1_carrier() -> bool:
    try:
        with open(f"/sys/class/net/{IFACE}/carrier") as f:
            return f.read().strip() == "1"
    except OSError:
        return False


def eno1_wol_state() -> str:
    out = run(["ethtool", IFACE]).stdout
    for line in out.splitlines():
        if "Wake-on" in line:
            val = line.split(":")[-1].strip()
            return "Armed (magic packet)" if val == "g" else "Off"
    # This driver doesn't report live Wake-on state to ethtool without
    # root, so fall back to the NetworkManager profile value — it's what
    # Magic itself sets, so it's accurate as long as nothing else changed it.
    r = run(["nmcli", "-t", "-f", "802-3-ethernet.wake-on-lan", "connection", "show", CONN])
    val = r.stdout.strip().rsplit(":", 1)[-1] if r.returncode == 0 else ""
    if val == "magic":
        return "Armed (magic packet)"
    if val:
        return "Off"
    return "Unknown"


def tailscale_state() -> str:
    r = run(["tailscale", "status", "--json"])
    if r.returncode != 0:
        return "Not running"
    try:
        backend = json.loads(r.stdout).get("BackendState", "Unknown")
    except (json.JSONDecodeError, AttributeError):
        return "Unknown"
    return {"Running": "Connected", "Stopped": "Stopped"}.get(backend, backend)


# -- Magic's own preferences (idle timeouts, last-used pairing name) --------


def load_state() -> dict:
    try:
        with open(STATE_FILE) as f:
            data = json.load(f)
    except (OSError, json.JSONDecodeError):
        data = {}
    return {**DEFAULT_STATE, **data}


def save_state(state: dict):
    os.makedirs(STATE_DIR, exist_ok=True)
    with open(STATE_FILE, "w") as f:
        json.dump(state, f, indent=2)


# -- COSMIC idle config (same files cosmic-settings' Power panel writes) ----


def _write_idle_key(name: str, ms: int | None):
    os.makedirs(IDLE_CONFIG_DIR, exist_ok=True)
    value = "None" if ms is None else f"Some({ms})"
    with open(os.path.join(IDLE_CONFIG_DIR, name), "w") as f:
        f.write(value)


def _read_idle_key(name: str) -> int | None:
    try:
        with open(os.path.join(IDLE_CONFIG_DIR, name)) as f:
            content = f.read().strip()
    except OSError:
        return None
    m = re.match(r"Some\((\d+)\)", content)
    return int(m.group(1)) if m else None


def set_idle_timeouts(screen_off_ms: int | None, suspend_ac_ms: int | None):
    _write_idle_key("screen_off_time", screen_off_ms)
    _write_idle_key("suspend_on_ac_time", suspend_ac_ms)


def idle_status_text() -> str:
    path = os.path.join(IDLE_CONFIG_DIR, "screen_off_time")
    if not os.path.exists(path):
        return "Using COSMIC default (never set here)"
    ms = _read_idle_key("screen_off_time")
    if ms is None:
        return "Disabled"
    return f"Lock after {ms // 60000} min"


# -- Sunshine web UI credentials (GNOME Keyring via libsecret) --------------


def get_sunshine_credentials():
    if not HAVE_SECRET:
        return None
    value = Secret.password_lookup_sync(SUNSHINE_SCHEMA, {"service": "sunshine-webui"}, None)
    if not value:
        return None
    try:
        data = json.loads(value)
        return data["username"], data["password"]
    except (json.JSONDecodeError, KeyError):
        return None


def set_sunshine_credentials(username: str, password: str) -> bool:
    if not HAVE_SECRET:
        return False
    payload = json.dumps({"username": username, "password": password})
    return Secret.password_store_sync(
        SUNSHINE_SCHEMA,
        {"service": "sunshine-webui"},
        Secret.COLLECTION_DEFAULT,
        "Magic — Sunshine Web UI Credentials",
        payload,
        None,
    )


def sunshine_pair(host: str, port: int, name: str, pin: str, username: str, password: str):
    """Returns (ok, message). Runs on a background thread."""
    body = json.dumps({"name": name, "pin": pin}).encode()
    auth = base64.b64encode(f"{username}:{password}".encode()).decode()
    headers = {"Content-Type": "application/json", "Authorization": f"Basic {auth}"}
    ctx = ssl._create_unverified_context()  # Sunshine's cert is self-signed, localhost-only
    try:
        conn = http.client.HTTPSConnection(host, port, timeout=10, context=ctx)
        conn.request("POST", "/api/pin", body=body, headers=headers)
        resp = conn.getresponse()
        raw = resp.read().decode(errors="replace")
        conn.close()
    except OSError as e:
        return False, f"Couldn't reach Sunshine at {host}:{port} ({e})"
    if resp.status == 401:
        return False, "Sunshine rejected the username/password. Update them via the menu."
    if resp.status != 200:
        return False, f"Sunshine returned HTTP {resp.status}: {raw}"
    try:
        data = json.loads(raw)
    except json.JSONDecodeError:
        return False, f"Unexpected response from Sunshine: {raw}"
    if data.get("status"):
        return True, "Paired successfully."
    return False, (
        "Sunshine rejected the PIN — make sure Moonlight is showing the "
        "pairing screen right now."
    )


