            page.add(group)

        dialog.present(self)


class MagicApp(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)
        self.create_action("uninstall", self._on_uninstall)
        self.create_action("about", self._on_about)
        self.create_action("preferences", lambda *_a: self.props.active_window.open_preferences())
        self.create_action(
            "sunshine_credentials",
            lambda *_a: self.props.active_window.open_sunshine_credentials(),
        )
        self.create_action("help", lambda *_a: self.props.active_window.open_help())

    def create_action(self, name, callback):
        action = Gio.SimpleAction.new(name, None)
        action.connect("activate", callback)
        self.add_action(action)

    def do_activate(self):
        win = self.props.active_window or MagicWindow(self)
        win.present()

    def _on_uninstall(self, *_args):
        win = self.props.active_window
        dialog = Adw.MessageDialog(
            transient_for=win,
            heading="Uninstall Magic?",
            body=(
                "This restores normal sleep/lock behavior, disarms "
                "Wake-on-LAN, and removes Magic's files, including the "
                "privileged helper and saved Sunshine credentials. This "
                "cannot be undone."
            ),
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("uninstall", "Uninstall")
        dialog.set_response_appearance("uninstall", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")

        def on_response(_d, response):
            if response == "uninstall":
                subprocess.Popen(
                    ["/bin/bash", GLib.get_home_dir() + "/.local/bin/magic-uninstall"]
                )
                self.quit()

        dialog.connect("response", on_response)
        dialog.present()

    def _on_about(self, *_args):
        about = Adw.AboutWindow(
            transient_for=self.props.active_window,
            application_name="Magic",
            application_icon="magic",
            version="3.0",
            comments="Toggle Away/Home power state for remote desktop access over Tailscale.",
        )
        about.present()


if __name__ == "__main__":
    import sys

    app = MagicApp()
    sys.exit(app.run(sys.argv))
