            if not is_away_mode():
                set_idle_timeouts(
                    self.state["home_screen_off_min"] * 60_000,
                    self.state["home_suspend_min"] * 60_000,
                )
                self.refresh_status()

        dialog.connect("closed", on_close)
        dialog.present(self)

