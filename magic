    # -- state application -------------------------------------------------

    def apply_mode_async(self, away: bool, on_done):
        """Runs the helper via a scoped passwordless sudo rule, on a
        background thread so the window never freezes. (Not pkexec —
        cosmic-osd's polkit agent has a bug that dismisses every polkit
        auth request on this system, so elevation goes through sudo -n
        instead, which doesn't touch that agent at all.)"""

        def worker():
            error = None
            action = "away" if away else "home"
            r = run(["sudo", "-n", HELPER, action], timeout=15)
            if r.returncode != 0:
                error = RuntimeError(
                    r.stderr.strip()
                    or "sudo -n failed — has magic-setup-sudoers.sh been run?"
                )
            else:
                if away:
                    set_idle_timeouts(None, None)
                else:
                    state = load_state()
                    set_idle_timeouts(
                        state["home_screen_off_min"] * 60_000,
                        state["home_suspend_min"] * 60_000,
                    )
            GLib.idle_add(on_done, error)

        threading.Thread(target=worker, daemon=True).start()

    def notify_system(self, title: str, body: str):
        n = Gio.Notification.new(title)
        n.set_body(body)
        self.get_application().send_notification(None, n)

    # -- switch handling -----------------------------------------------------

    def _sync_switch_to_reality(self):
        self._syncing = True
        self.switch_row.set_active(is_away_mode())
        self._syncing = False

    def _set_switch_silently(self, value: bool):
        self._syncing = True
        self.switch_row.set_active(value)
        self._syncing = False

    def _on_switch_toggled(self, row, _pspec):
        if self._syncing:
            return
        wants_away = row.get_active()
        if wants_away:
            if not eno1_carrier():
                self._set_switch_silently(False)
                self._warn_no_ethernet()
                return
            self._confirm_away_mode()
        else:
            self._commit(False)

    def _warn_no_ethernet(self):
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Ethernet not detected",
            body=(
                "Away Mode arms Wake-on-LAN on eno1, but no cable is plugged "
                "in right now. Plug in Ethernet and try again."
            ),
        )
        dialog.add_response("ok", "OK")
        dialog.present()

    def _confirm_away_mode(self):
        dialog = Adw.MessageDialog(
            transient_for=self,
            heading="Enable Away Mode?",
            body=(
                "This system will no longer sleep, suspend, hibernate, or "
                "lock its screen while Away Mode is on — it stays fully "
                "awake so Tailscale and Sunshine keep working remotely. "
                "Wake-on-LAN will be armed on eno1.\n\n"
                "If the Ethernet cable is unplugged later, Magic will "
                "revert to Home Mode automatically."
            ),
        )
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("enable", "Enable Away Mode")
        dialog.set_response_appearance("enable", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", self._on_confirm_response)
        dialog.present()

    def _on_confirm_response(self, dialog, response):
        if response == "enable":
            self._commit(True)
        else:
            self._set_switch_silently(False)

    def _commit(self, away: bool):
        if self._applying:
            return
        self._applying = True
        self.switch_row.set_sensitive(False)
        self.switch_row.set_subtitle("Applying…")

        def done(error):
            self._applying = False
            self.switch_row.set_sensitive(True)
            self.switch_row.set_subtitle("Block sleep and lock, arm Wake-on-LAN")
            if error is not None:
                self._set_switch_silently(not away)
                self._error(str(error))
                return False
            self._set_switch_silently(away)
            label = "Away Mode enabled" if away else "Home Mode restored"
            detail = (
                "Sleep, hibernate, and screen lock are disabled; Wake-on-LAN is armed."
                if away
                else "Normal sleep, suspend, and screen lock are back in effect."
            )
            self.notify_system(f"Magic — {label}", detail)
            self.refresh_status()
            return False

        self.apply_mode_async(away, done)

    def _error(self, message: str, heading: str = "Magic couldn't apply that change"):
        dialog = Adw.MessageDialog(transient_for=self, heading=heading, body=message)
        dialog.add_response("ok", "OK")
        dialog.present()

    # -- polling / status ----------------------------------------------------

    def _on_poll(self):
        away = is_away_mode()
        carrier = eno1_carrier()
        if away and not carrier and not self._applying:
            self._auto_revert_home()
        self.refresh_status()
        return True

    def _auto_revert_home(self):
        self._applying = True
        self.switch_row.set_sensitive(False)

        def done(error):
            self._applying = False
            self.switch_row.set_sensitive(True)
            if error is not None:
                self.notify_system("Magic — auto-revert failed", str(error))
                return False
            self._set_switch_silently(False)
            self.notify_system(
                "Magic — Ethernet unplugged",
                "Away Mode needs eno1 connected for Wake-on-LAN, so Magic switched "
                "back to Home Mode automatically.",
            )
            return False

        self.apply_mode_async(False, done)

    def refresh_status(self):
        carrier = eno1_carrier()
        self.row_eth.value_label.set_label("Connected" if carrier else "Disconnected")
        self.row_wol.value_label.set_label(eno1_wol_state())
        self.row_sleep.value_label.set_label(
            "Disabled (Away Mode)" if is_away_mode() else idle_status_text()
        )
        self.row_ts.value_label.set_label(tailscale_state())

    # -- Sunshine pairing -----------------------------------------------------

    def _on_pair_clicked(self, _button):
        name = self.device_name_row.get_text().strip()
        pin = self.pin_row.get_text().strip()
        if not name:
            self._error("Enter a device name first.", heading="Missing device name")
            return
        if not (pin.isdigit() and len(pin) == 4):
            self._error(
                "PIN must be exactly 4 digits, as shown on the device you're pairing.",
                heading="Invalid PIN",
            )
            return

        creds = get_sunshine_credentials()
        if creds is None:
            if not HAVE_SECRET:
                self._error(
                    "GNOME Keyring support isn't installed yet. Run:\n\n"
                    "sudo apt install gir1.2-secret-1\n\n"
                    "then restart Magic.",
                    heading="Keyring unavailable",
                )
            else:
                self._error(
                    "Set your Sunshine web UI username/password first via the "
                    "menu → Sunshine Credentials…",
                    heading="No Sunshine credentials saved",
                )
            return

        username, password = creds
        host = self.state["sunshine_host"]
        port = self.state["sunshine_port"]
        threading.Thread(
            target=self._pair_worker,
            args=(host, port, name, pin, username, password),
            daemon=True,
        ).start()

    def _pair_worker(self, host, port, name, pin, username, password):
        ok, message = sunshine_pair(host, port, name, pin, username, password)
        GLib.idle_add(self._on_pair_result, ok, message, name)

    def _on_pair_result(self, ok: bool, message: str, name: str):
        if ok:
            self.state["last_device_name"] = name
            save_state(self.state)
            self.pin_row.set_text("")
            self.notify_system("Magic — Sunshine paired", f"{name} is now paired.")
        else:
            self._error(message, heading="Pairing failed")
        return False

